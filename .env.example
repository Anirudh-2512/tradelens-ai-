# TradeLens AI — copy to .env.local and fill in real values.
# NEVER commit .env.local to source control.

# ── Required ────────────────────────────────────────────────

# Finnhub — market data (quotes, candles, search, news)
FINNHUB_API_KEY=
# Finnhub webhook secret (real-time trade updates, optional but recommended)
FINNHUB_WEBHOOK_SECRET=

# Groq — AI market summaries
GROQ_API_KEY=

# Turso (libSQL) — persistent storage
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=

# Secret used to sign session tokens (min 32 chars). Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ── Optional (app degrades gracefully when absent) ──────────

# Marketaux — additional financial news
MARKETAUX_API_TOKEN=

# Currents — additional general news
CURRENTS_API_KEY=

# Resend — email verification delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
